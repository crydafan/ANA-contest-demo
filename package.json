{
  "name": "ana-contest-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @ana-contest-demo/client dev",
    "build": "pnpm --filter @ana-contest-demo/client build",
    "start": "pnpm --filter @ana-contest-demo/client start",
    "dev:realtime": "pnpm --filter @ana-contest-demo/realtime dev",
    "start:realtime": "pnpm --filter @ana-contest-demo/realtime start",
    "test": "pnpm --recursive test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:db": "pnpm --filter @ana-contest-demo/db test:db",
    "db:generate": "pnpm --filter @ana-contest-demo/db db:generate",
    "db:migrate": "pnpm --filter @ana-contest-demo/db db:migrate",
    "db:seed": "pnpm --filter @ana-contest-demo/db db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2"
  },
  "packageManager": "pnpm@11.7.0"
}
