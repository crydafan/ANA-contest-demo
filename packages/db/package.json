    "test:db": "RUN_DATABASE_TESTS=1 tsx --test src/repository.integration.test.ts"
  },
  "dependencies": {
    "@ana-contest-demo/contract": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
